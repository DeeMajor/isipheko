# Tolerate slow or lossy links. Not a CI concern — this is a South African
# product and some of the people building it are on the same connections the
# contributors are. Low concurrency is what actually fixes a flaky link;
# the default of 16 parallel fetches makes packet loss much worse.
fetch-retries=8
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=180000
network-concurrency=4
