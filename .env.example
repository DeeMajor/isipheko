# Copy to .env before running the app:  cp .env.example .env
#
# Every variable here is validated by src/lib/env.ts at boot. A missing or
# malformed value stops the server starting — it does not surface later as a
# runtime error on someone's contribution.
#
# In development the values below are also the built-in defaults, so a clean
# clone runs without this file. In production there are no defaults and every
# variable is required.

# Public origin of the app. Used for share links and OG image URLs, so it must
# be the externally reachable origin, not a container-internal one.
NEXT_PUBLIC_APP_URL=http://localhost:3000
